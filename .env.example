# Copy this file to ~/.config/video-style-transfer-eval/env (chmod 600)
# or export the variables in your shell before running scripts/vlm_judge.py.
# Never commit real keys.

# Qwen-VL via DashScope (provider: qwen)
DASHSCOPE_API_KEY=
# Mainland China endpoint (default). For the international account use:
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Gemini (provider: gemini). Region-restricted: not available in Hong Kong.
# Leave empty to use Qwen-VL only.
GEMINI_API_KEY=
